# ============================================================================
#  CataForge 环境配置示例
#  复制为 .env 后根据实际情况修改
#  用法: cp .env.example .env && vi .env
# ============================================================================

# --- GitHub Token ---
# 用于远程升级检测 (upgrade.py check/upgrade 命令)
# 生成地址: https://github.com/settings/tokens
# 私有仓库必须配置；公开仓库可选（避免 API 限流）
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# --- 网络代理 ---
# 用于受限网络环境下的 git clone / npm install / GitHub API 调用
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.example.com

# --- Penpot 设计集成 (可选，仅 design_tool=penpot 时需要) ---
# PENPOT_MCP_URL 是下游分发与 remote 模式的统一 MCP endpoint 事实源：
#   自托管 (cataforge penpot deploy)：可不设，默认 http://localhost:${PENPOT_PORT}/mcp/stream
#   托管/SaaS (cataforge penpot remote)：https://design.penpot.app/mcp/stream?userToken=<MCP_KEY>
# token 随本变量留在 .env（gitignored），不写入 git-tracked 的 .cataforge/mcp/penpot.yaml。
# PENPOT_MCP_URL=https://design.penpot.app/mcp/stream?userToken=xxxxx
# PENPOT_VERSION=2.16              # 全部 Penpot 镜像 (frontend/backend/exporter/mcp) 的统一 tag
# PENPOT_PORT=9001                 # 自托管 frontend 端口（自托管 MCP 入口为 :${PENPOT_PORT}/mcp/stream）
# PENPOT_BASE_URL=http://localhost:9001
# PENPOT_INSTALL_DIR=$HOME/penpot-docker   # docker-compose.yml 落盘位置
# PENPOT_MCP_SERVER_PORT=4401      # 仅 npx 模式 (mcp-only)，已不推荐
# PENPOT_MCP_PLUGIN_PORT=4400      # 仅 npx 模式 (mcp-only)，已不推荐
# PENPOT_MCP_VERSION=2.15.0        # 仅 npx 模式 (mcp-only)，已不推荐
