# ============================================================================
#  CataForge 环境配置示例
#  复制为 .env 后根据实际情况修改
#  用法: cp .env.example .env && vi .env
# ============================================================================

# --- GitHub Token ---
# 用于远程升级检测 (upgrade.py check/upgrade 命令)
# 生成地址: https://github.com/settings/tokens
# 私有仓库必须配置；公开仓库可选（避免 API 限流）
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# --- 网络代理 ---
# 用于受限网络环境下的 git clone / npm install / GitHub API 调用
# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=http://proxy.example.com:8080
# NO_PROXY=localhost,127.0.0.1,.example.com

# --- Penpot 设计集成 (可选，仅 design_tool=penpot 时需要) ---
# 自托管 (cataforge penpot deploy)：MCP 是 compose 内的 penpot-mcp 容器，
# 经 frontend 反代到 http://localhost:${PENPOT_PORT}/mcp/stream，无需宿主机 Node。
# remote / mcp-only：MCP 走宿主机 npx，需 Node。
# PENPOT_VERSION=2.16              # 全部 Penpot 镜像 (frontend/backend/exporter/mcp) 的统一 tag
# PENPOT_PORT=9001                 # 自托管 frontend 端口
# PENPOT_BASE_URL=http://localhost:9001
# PENPOT_INSTALL_DIR=$HOME/penpot-docker   # docker-compose.yml 落盘位置
# PENPOT_MCP_SERVER_PORT=4401      # remote / mcp-only 的 npx MCP 端口
# PENPOT_MCP_PLUGIN_PORT=4400      # remote / mcp-only 的 npx 插件端口
# PENPOT_MCP_VERSION=2.15.0        # remote / mcp-only 的 npm @penpot/mcp 版本
