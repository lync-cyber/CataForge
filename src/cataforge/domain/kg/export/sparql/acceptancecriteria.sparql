PREFIX cf: <https://cataforge.dev/ontology/>

SELECT
  ?entity_id ?sort_key ?title ?description ?status
  ?content_hash ?source_doc ?source_section ?authored_by
  ?narrative_body
  ?parent_id ?parent_sort_key ?parent_title
  ?feature_id ?feature_sort_key ?feature_title
  ?tc_id ?tc_sort_key ?tc_title
WHERE {
  ?ac a cf:AcceptanceCriteria ;
      cf:entity_id %(entity_id)s ;
      cf:entity_id ?entity_id ;
      cf:sort_key  ?sort_key ;
      cf:title     ?title .

  OPTIONAL { ?ac cf:description    ?description }
  OPTIONAL { ?ac cf:status         ?status }
  OPTIONAL { ?ac cf:content_hash   ?content_hash }
  OPTIONAL { ?ac cf:source_doc     ?source_doc }
  OPTIONAL { ?ac cf:source_section ?source_section }
  OPTIONAL { ?ac cf:authored_by    ?authored_by }

  OPTIONAL { ?ac cf:narrative_body ?own_narrative }
  OPTIONAL {
    ?ac cf:source_doc ?nb_doc ; cf:source_section ?nb_anchor .
    ?nb_section a cf:Section ;
                cf:source_doc     ?nb_doc ;
                cf:section_anchor ?nb_anchor ;
                cf:narrative_body ?section_narrative .
  }
  BIND(COALESCE(?own_narrative, ?section_narrative) AS ?narrative_body)

  OPTIONAL {
    ?ac cf:part_of ?parent .
    ?parent cf:entity_id ?parent_id ;
            cf:sort_key  ?parent_sort_key ;
            cf:title     ?parent_title .
  }

  OPTIONAL {
    ?ac cf:satisfies ?feature .
    ?feature cf:entity_id ?feature_id ;
             cf:sort_key  ?feature_sort_key ;
             cf:title     ?feature_title .
  }

  OPTIONAL {
    ?tc a cf:TestCase ;
        cf:verifies ?ac ;
        cf:entity_id ?tc_id ;
        cf:sort_key  ?tc_sort_key ;
        cf:title     ?tc_title .
  }
}
ORDER BY ?sort_key ?parent_sort_key ?feature_sort_key ?tc_sort_key
