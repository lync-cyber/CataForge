PREFIX cf: <https://cataforge.dev/ontology/>

SELECT
  ?entity_id ?sort_key ?title ?description ?status ?priority
  ?content_hash ?source_doc ?source_section ?authored_by
  ?narrative_body
  ?task_status
  ?real_id ?real_sort_key ?real_title
  ?ac_id ?ac_sort_key ?ac_title
  ?tc_id ?tc_sort_key ?tc_title
WHERE {
  ?task a cf:Task ;
        cf:entity_id %(entity_id)s ;
        cf:entity_id ?entity_id ;
        cf:sort_key  ?sort_key ;
        cf:title     ?title .

  OPTIONAL { ?task cf:description    ?description }
  OPTIONAL { ?task cf:status         ?status }
  OPTIONAL { ?task cf:priority       ?priority }
  OPTIONAL { ?task cf:content_hash   ?content_hash }
  OPTIONAL { ?task cf:source_doc     ?source_doc }
  OPTIONAL { ?task cf:source_section ?source_section }
  OPTIONAL { ?task cf:authored_by    ?authored_by }
  OPTIONAL { ?task cf:task_status    ?task_status }

  OPTIONAL {
    ?task cf:source_doc ?nb_doc ; cf:source_section ?nb_anchor .
    ?nb_section a cf:Section ;
                cf:source_doc     ?nb_doc ;
                cf:section_anchor ?nb_anchor ;
                cf:narrative_body ?narrative_body .
  }

  OPTIONAL {
    ?task cf:realizes ?real .
    ?real cf:entity_id ?real_id ;
          cf:sort_key  ?real_sort_key ;
          cf:title     ?real_title .
  }

  OPTIONAL {
    ?task cf:satisfies ?ac .
    ?ac cf:entity_id ?ac_id ;
        cf:sort_key  ?ac_sort_key ;
        cf:title     ?ac_title .
  }

  OPTIONAL {
    ?tc a cf:TestCase ;
        cf:verifies ?task ;
        cf:entity_id ?tc_id ;
        cf:sort_key  ?tc_sort_key ;
        cf:title     ?tc_title .
  }
}
ORDER BY ?sort_key ?real_sort_key ?ac_sort_key ?tc_sort_key
