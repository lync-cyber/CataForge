platform_id: claude-code
display_name: Claude Code

tool_map:
  file_read: {tool: Read, kind: native}
  file_write: {tool: Write, kind: native}
  file_edit: {tool: Edit, kind: native, hook_matchers: [Edit, Write]}
  file_glob: {tool: Glob, kind: native}
  file_grep: {tool: Grep, kind: native}
  shell_exec: {tool: Bash, kind: native}
  web_search: {tool: WebSearch, kind: native}
  web_fetch: {tool: WebFetch, kind: native}
  user_question: {tool: AskUserQuestion, kind: native}
  agent_dispatch: {tool: Agent, kind: native}

agent_config:
  tool_policy: allow_deny

agent_definition:
  format: yaml-frontmatter
  scan_dirs:
    - .claude/agents
  needs_deploy: true

dispatch:
  tool_name: Agent
  is_async: false
  params: [subagent_type, prompt, description]

hooks:
  config_format: json
  config_path: .claude/settings.json
  event_map:
    PreToolUse: PreToolUse
    PostToolUse: PostToolUse
    Stop: Stop
    SessionStart: SessionStart
  policies: {}

features:
  parallel_agents: true
  background_agents: true
  subagent_interactive: false
  agent_memory: true
  worktree_isolation: true
  plan_mode: true

permissions:
  modes: [default, acceptEdits, auto, dontAsk, bypassPermissions, plan]
