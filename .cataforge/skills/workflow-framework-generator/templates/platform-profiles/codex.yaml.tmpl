platform_id: codex
display_name: Codex CLI

tool_map:
  file_read: {tool: shell, kind: replacement}
  file_write: {tool: apply_patch, kind: native}
  file_edit: {tool: apply_patch, kind: native}
  file_glob: {tool: shell, kind: replacement}
  file_grep: {tool: shell, kind: replacement}
  shell_exec: {tool: shell, kind: native, hook_matchers: [Bash]}
  web_search: {tool: web_search, kind: native}
  web_fetch: {tool: shell, kind: replacement}
  user_question:
    tool: request_user_input
    kind: native
    hook_matchers: [request_user_input]
    availability:
      any_of:
        - thread_scopes: [root]
          collaboration_modes: [plan]
        - thread_scopes: [root]
          collaboration_modes: [default]
          required_features: [default_mode_request_user_input]
  agent_dispatch: {tool: spawn_agent, kind: native}

agent_config:
  tool_policy: inherit_only

agent_definition:
  format: toml
  scan_dirs:
    - .codex/agents
  needs_deploy: true

dispatch:
  tool_name: spawn_agent
  is_async: true
  params: [agent_type, message, task_name]

hooks:
  config_format: json
  config_path: .codex/hooks.json
  event_map:
    PreToolUse: PreToolUse
    PostToolUse: PostToolUse
    Stop: Stop
    SessionStart: SessionStart
    Notification: PermissionRequest
  policies:
    detect_correction:
      mode: hybrid
      fallback:
        strategy: prompt_instruction
        coverage: partial
        reason: "直接文本纠偏需人工记录"
        content: "用户直接纠正既有选择时运行 cataforge correction add；不得使用文本启发式猜测。"

features:
  parallel_agents: true
  background_agents: true
  subagent_interactive: false
  agent_memory: true
  worktree_isolation: false
  plan_mode: true

permissions:
  modes: [untrusted, on-request, never]
