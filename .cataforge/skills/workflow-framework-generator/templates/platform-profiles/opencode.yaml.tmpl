platform_id: opencode
display_name: OpenCode

tool_map:
  file_read: {tool: read, kind: native}
  file_write: {tool: write, kind: native}
  file_edit: {tool: edit, kind: native}
  file_glob: {tool: glob, kind: native}
  file_grep: {tool: grep, kind: native}
  shell_exec: {tool: bash, kind: native}
  web_search: {tool: websearch, kind: native}
  web_fetch: {tool: webfetch, kind: native}
  user_question: {tool: question, kind: native}
  agent_dispatch: {tool: task, kind: native}

agent_config:
  tool_policy: allow_only

agent_definition:
  format: yaml-frontmatter
  scan_dirs:
    - .opencode/agents
  needs_deploy: true

dispatch:
  tool_name: task
  is_async: false
  params: [subagent_type, description, prompt]

hooks:
  config_format: plugin
  config_path: .opencode/plugins/
  event_map:
    PreToolUse: tool.execute.before
    PostToolUse: tool.execute.after
    Stop: session.idle
    SessionStart: session.created
  policies: {}

features:
  parallel_agents: false
  background_agents: false
  subagent_interactive: false
  agent_memory: false
  worktree_isolation: false
  plan_mode: true

permissions:
  modes: [default]
